# This file lives at the repo root only because Docker requires .dockerignore
# to sit in the build context root, and the backend/ services in
# docker-compose.yml use "context: ." (needed so their Dockerfiles can reach
# the repo-root .editorconfig). It is NOT a repo-wide ignore file: Docker only
# reads it for builds whose context is ".", i.e. backend/db_init/unit-tests/
# integration-tests. The frontend service has its own context (frontend/) and
# never sees this file.
#
# The block below excludes repo-root items backend builds never need.
.claude/
.github/
.vercelignore
CONTRIBUTING.md
LogoBirreria568-1.png
LogoBirreria568.pdf
docs/
frontend/
io/
vercel.json

